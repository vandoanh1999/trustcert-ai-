# --- Biến môi trường chung ---
LOG_LEVEL=INFO
# Tên model chính cho vLLM và Trainer
BASE_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
# Model embedding
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Kích thước vector của model embedding
EMBEDDING_MODEL_DIM=384

# --- Cấu hình Kết nối ---
REDIS_HOST=redis
REDIS_PORT=6379
QDRANT_HOST=qdrant
QDRANT_PORT=6333
NEO4J_URI=bolt://neo4j:7687
VLLM_API_BASE=http://vllm:8001/v1

# --- Cấu hình Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Cấu hình API Gateway ---
# Một API key bí mật để bảo vệ các endpoint
API_KEY=your_super_secret_api_key

# --- Cấu hình Lưu trữ LoRA (S3/MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=lora-storage
