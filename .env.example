# --- Cấu hình Nền tảng Cloud (Thay thế Docker) ---
# Neo4j AuraDB
NEO4J_URI=bolt+s://your-neo4j-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Qdrant Cloud
QDRANT_URL=https://your-qdrant-cluster.xyz.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Hugging Face (Dành cho bước sau)
HF_TOKEN=your_huggingface_read_token # Chỉ cần quyền đọc là đủ

# --- Cấu hình API Gateway ---
API_KEY=your_super_secret_api_key
LOG_LEVEL=INFO

# --- Các cấu hình khác (Dành cho bước sau) ---
BASE_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_DIM=384
S3_BUCKET_NAME=lora-storage
